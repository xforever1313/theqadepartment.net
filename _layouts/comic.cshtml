---
layout: layout
---
@using SitePlugin;
@using Pretzel.Logic.Extensibility.Extensions;
@using Pretzel.SethExtensions;
@using Page = Pretzel.Logic.Templating.Context.Page

@{
    // Any page that contains a comic.
}

@{
    Page first = Model.Site.TryGetFirstPost();
    Page last = Model.Site.TryGetLastPost();
}

<article id="maincontents" class="blog-post">
    <div class="row pager-controls col-xs-10 col-xs-offset-1 col-sm-6 col-sm-offset-3">
        <div class="col-xs-3 text-left">
            @if( first == null )
            {
                <i class="fa-solid fa-angles-left pager-disabled" title="First"></i>
            }
            else
            {
                <a href="@first.Url" title="First" class="pager-enabled">
                    <i class="fa-solid fa-angles-left"></i>
                </a>
            }
        </div>
        <div class="col-xs-3 text-center">
            @if( Model.Previous == null )
            {
                <i class="fa-solid fa-angle-left pager-disabled" title="Previous"></i>
            }
            else
            {
                <a href="@Model.Previous.Url" title="Previous" class="pager-enabled">
                    <i class="fa-solid fa-angle-left"></i>
                </a>
            }
        </div>
        <div class="col-xs-3 text-center">
            @if( Model.Next == null )
            {
                <i class="fa-solid fa-angle-right pager-disabled" title="Next"></i>
            }
            else
            {
                <a href="@Model.Previous.Url" title="Next" class="pager-enabled">
                    <i class="fa-solid fa-angle-right"></i>
                </a>
            }
        </div>
        <div class="col-xs-3 text-right">
            @if( last == null )
            {
                <i class="fa-solid fa-angles-right pager-disabled" title="Most Recent"></i>
            }
            else
            {
                <a href="@last.Url" title="Most Recent" class="pager-enabled">
                    <i class="fa-solid fa-angles-right"></i>
                </a>
            }
        </div>
    </div>
    <div class="body">
        <div id="qadate" class="row">
            <div class="col-md-12">
                <i class="fa-solid fa-calendar"> @Model.Page.Date.ToString( "MMM dd yyyy" )</i>
            </div>
        </div>
        <hr/>
        <div class="row">
            <figure class="lead-image col-md-12">
                <img class="img-responsive center-block" src="/static/comics/@Model.Page.Bag["comic"]" alt="@Model.Page.Bag["alttext"]" />
            </figure>
        </div>
        <hr />
        <div class="row">
            <div class="col-md-12">
                <details id="transcript">
                    <summary>View Transcript</summary>
                    <div id="transcript-blockquote">
                        <blockquote>
                            @Raw( Model.Page.GetPageTranscript() )
                        </blockquote>
                    </div>
                </details>
            </div>
        </div>
        <div id="pagecontents" class="row">
            <div class="col-md-12">
                @Raw( Model.Content )
            </div>
        </div>
    </div>
    <div class="row">
        <div class="pager-controls col-xs-10 col-xs-offset-1 col-sm-6 col-sm-offset-3">
            <div class="col-xs-3 text-left">
                @if( first == null )
                {
                    <i class="fa-solid fa-angles-left pager-disabled" title="First"></i>
                }
                else
                {
                    <a href="@first.Url" title="First" class="pager-enabled">
                        <i class="fa-solid fa-angles-left"></i>
                    </a>
                }
            </div>
            <div class="col-xs-3 text-center">
                @if( Model.Previous == null )
                {
                    <i class="fa-solid fa-angle-left pager-disabled" title="Previous"></i>
                }
                else
                {
                    <a href="@Model.Previous.Url" title="Previous" class="pager-enabled">
                        <i class="fa-solid fa-angle-left"></i>
                    </a>
                }
            </div>
            <div class="col-xs-3 text-center">
                @if( Model.Next == null )
                {
                    <i class="fa-solid fa-angle-right pager-disabled" title="Next"></i>
                }
                else
                {
                    <a href="@Model.Previous.Url" title="Next" class="pager-enabled">
                        <i class="fa-solid fa-angle-right"></i>
                    </a>
                }
            </div>
            <div class="col-xs-3 text-right">
                @if( last == null )
                {
                    <i class="fa-solid fa-angles-right pager-disabled" title="Most Recent"></i>
                }
                else
                {
                    <a href="@last.Url" title="Most Recent" class="pager-enabled">
                        <i class="fa-solid fa-angles-right"></i>
                    </a>
                }
            </div>
        </div>
    </div>
</article>

@if( Model.Page.Tags.Any() )
{
    <div class="row">
        <div clas="col-md-12">
            <aside id="tags" class="clearfix">
                <h2>Tagged as:</h2>
                <ul class="tags">
                @foreach( string tag in Model.Page.Tags )
                {
                    <li><a href="/tag/@SlugifyFilter.Slugify( tag )/">@tag</a></li>
                }
                </ul>
            </aside>
        </div>
    </div>
}
