---
layout: page
---

@using SitePlugin;

<div class="div">
    <div class="col-md-12">
        <ul>
            @{
                foreach( var post in @Model.Site.Posts )
                {
                    @:<li>
                    @:  <a href="@post.Url">#@post.GetComicId(): @post.Title</a> - @post.Bag["description"]
                    @:</li>
                }
            }
        </ul>
    </div>
</div>
